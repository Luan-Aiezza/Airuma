<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- The packages that come with the Godot editor (for Godot.NET.Sdk), kept first so that builds work offline. -->
    <add key="GodotLocal" value="/Users/luan/Desktop/Godot_mono.app/Contents/Resources/GodotSharp/Tools/nupkgs" />
    <!-- Exporting to another platform (Windows from a Mac) needs that platform's .NET runtime pack, which is only on nuget.org. -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
